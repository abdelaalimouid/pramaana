# Databricks workspace
DATABRICKS_HOST=https://<workspace-id>.azuredatabricks.net
DATABRICKS_TOKEN=<personal-access-token>
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>

# MLflow (set to "databricks" to use Databricks-managed MLflow)
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Users/<your-email@domain.com>/pramaana

# LLM — primary is Databricks-served Llama via Agent Bricks
DATABRICKS_LLM_ENDPOINT=databricks-meta-llama-3-1-70b-instruct

# Tavily web validator (the killshot)
TAVILY_API_KEY=<tavily-key>
